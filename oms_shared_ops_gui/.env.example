# Optional — uses default AWS credential chain if unset.
# You can also point at oms_ec2_connector creds:
# OMS_OPS_ENV_FILE=C:\PROD\ConnectorSuite\oms_ec2_connector\.env.pod2dev

AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=


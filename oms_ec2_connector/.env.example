# Copy to .env.pod2dev and fill in values (never commit .env.*)

ENV_NAME=pod2dev
AWS_REGION=us-east-1

# Optional: only needed if default AWS profile/credentials are not configured
# AWS_ACCESS_KEY_ID=replace_me
# AWS_SECRET_ACCESS_KEY=replace_me
# AWS_SESSION_TOKEN=replace_me

# EC2 Name tag prefix used by `refresh`
EC2_NAME_PREFIX=oms-pod2-dev-

# Instance inventory (IDs and IPs from AWS describe-instances)
# Format: INSTANCE_<alias>_ID, INSTANCE_<alias>_IP, optional INSTANCE_<alias>_PUBLIC_IP

INSTANCE_BASTION_ID=i-0b489a48f31463d74
INSTANCE_BASTION_IP=20.115.111.220
INSTANCE_BASTION_PUBLIC_IP=44.212.64.148

INSTANCE_API_ID=i-02b70bcb094c2dcec
INSTANCE_API_IP=20.115.11.82

INSTANCE_SERVICES_ID=i-0f603ed7f8f947bd7
INSTANCE_SERVICES_IP=20.115.11.135

INSTANCE_SITEMANAGER_ID=i-036505377f8ad5c6e
INSTANCE_SITEMANAGER_IP=20.115.11.102

INSTANCE_RDS_MIGRATION_ID=i-0f2a63e597d421e39
INSTANCE_RDS_MIGRATION_IP=20.115.11.208

INSTANCE_CONTENT_ID=i-0d23caf16cd2c5adb
INSTANCE_CONTENT_IP=20.115.11.54

INSTANCE_TORONADO_ID=i-0aee83fe4726581e4
INSTANCE_TORONADO_IP=20.115.11.213

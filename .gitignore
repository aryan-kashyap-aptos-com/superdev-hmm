.env
.token.json
connectors/results/
__pycache__/
*.pyc
# saved chats stay on this machine
chat-sessions/2*.md
chat-sessions/INDEX.md
chat-sessions/LATEST.md
# QA runs hold screenshots and logs that can contain customer data
qa-tester/runs/*
!qa-tester/runs/.gitkeep
qa-tester/.browser-profile/
qa-tester/sites/
qa-tester/environments.local.md
# saved scenarios hold internal page paths: keep them private
qa-tester/scenarios/*
!qa-tester/scenarios/.gitkeep
!qa-tester/scenarios/README.md
# real product facts (real sites, real systems): keep them private, same reason as environments.local.md
product-knowledge-local/

# md-reader: files you dropped in to read are yours, not for the repo
tools/md-reader/library/
tools/md-reader/exports/
tools/md-reader/assets/

# api-client: imported collections/environments can hold real tokens and passwords; evidence can hold response data
tools/api-client/data/*
!tools/api-client/data/.gitkeep
tools/api-client/evidence/*
!tools/api-client/evidence/.gitkeep

# Copy to .env and fill in values (never commit .env)

# PostgreSQL via local tunnel
PGHOST=127.0.0.1
PGPORT=1112
PGDATABASE=regression202510qa
PGUSER=podqa_postgres
PGPASSWORD=replace_me
PGSSLMODE=require
PGCONNECT_TIMEOUT=300

# SSH tunnel (bastion -> RDS proxy)
SSH_HOST=your-bastion-host
SSH_PORT=22
SSH_USER=ec2-user
SSH_PPK_PATH=C:\path\to\your-key.ppk
SSH_REMOTE_HOST=your-rds-proxy-host
SSH_REMOTE_PORT=5432

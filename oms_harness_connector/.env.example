# Harness Platform API key (PAT or SAT recommended: pat.<accountId>... or sat.<accountId>...)
HARNESS_API_KEY=

# Optional: only if your key does not embed account id
# HARNESS_ACCOUNT_ID=

# Aptos OMS (display name) — confirm org id in Harness URL: .../orgs/<id>/projects/...
# UI "Aptos OMS" org is often identifier OMS_CICD (confirm in URL)
HARNESS_ORG=OMS_CICD
# OMS Development = team dev CI; OMS_DevOps = release/Harness maintenance; client pods use their own project ids
HARNESS_PROJECT=OMS_Development

# Use for private / non-app.harness.io SaaS (see Harness docs)
# HARNESS_BASE_URL=https://app.harness.io

# Database (PostgreSQL)
DB_HOST=db.internal.example.com     # host as seen from where you connect (or from the SSH host)
DB_PORT=5432
DB_NAME=mydb
DB_USER=readonly_user
DB_PASSWORD=
DB_SSLMODE=prefer                   # disable | prefer | require | verify-full
DB_TIMEOUT_SECONDS=60

# SSH tunnel (leave SSH_HOST empty to connect directly)
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_KEY=~/.ssh/id_ed25519           # OpenSSH format key

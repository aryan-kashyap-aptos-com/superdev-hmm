# AWS login: use a profile (recommended) or the standard AWS_* key variables.
AWS_PROFILE=my-profile
AWS_REGION=us-east-1

# Aurora PostgreSQL cluster with the Data API turned on
RDS_CLUSTER_ARN=arn:aws:rds:us-east-1:123456789012:cluster:my-cluster
RDS_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:my-db-secret
DB_NAME=mydb

# Copy to .env and fill in values (never commit .env)

# AWS credentials (session token required for temporary STS credentials)
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
AWS_SESSION_TOKEN=replace_me
AWS_REGION=us-east-1

# RDS cluster (matches "Database instance or cluster" in the AWS console)
RDS_CLUSTER_ID=oms-roadrunner-uat-postgresql2-cluster

# Secrets Manager ARN for the RDS database secret
SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:your-rds-secret

# Target database name (overrides dbname in the secret JSON when set)
PGDATABASE=your_database_name

# Connection mode:
#   data_api  - use RDS Data API (same as AWS Query Editor; no tunnel needed)
#   direct    - direct PostgreSQL TCP connection
#   auto      - try direct first, fall back to data_api
CONNECTION_MODE=data_api

# Optional connection overrides for direct mode only
# PGHOST=127.0.0.1
# PGPORT=5432
PGSSLMODE=require
PGCONNECT_TIMEOUT=30
PGPROBE_TIMEOUT=8
